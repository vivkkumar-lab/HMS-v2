# Backend Environment Configuration for Render & Production
# Copy this to .env or set these in Render Dashboard -> Environment

# Database Connection (Render PostgreSQL internal connection string)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# JWT Authentication Secret Key (Required for production - keep confidential)
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_secure_random_secret_string

# Allowed CORS Origins (Comma-separated list including your Vercel frontend domain)
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# Platform / Production Environment indicator
ENVIRONMENT=production

# Initial Admin Credentials (Optional: used to initialize admin account securely on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SetAStrongPasswordHere123!

# Platform Port (Render injects this automatically)
PORT=8000
